# Leave cloud API keys blank until you choose to use a provider. Never commit a real key.
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45

# Local default (no API key required)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI-compatible providers: OpenAI, DeepSeek, Qwen-compatible endpoints, OpenRouter, etc.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_API_KEY=

# Anthropic Messages API
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
